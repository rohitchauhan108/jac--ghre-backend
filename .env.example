PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dadi-industries
FRONTEND_URL=https://jac-ghre.vercel.app
API_PUBLIC_URL=http://localhost:4000

# Auth (required) — any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# PhonePe payment gateway (required for online payments; COD works without it)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Resend transactional email (required for sign-up OTP / password-reset / order confirmations)
# 1. Add & verify your sending domain at https://resend.com/domains
#    - DKIM:  TXT  resend._domainkey   -> copy value from Resend dashboard
#    - SPF:   TXT  (root / @)          -> v=spf1 include:spf.resend.com ~all
# 2. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address you verified in Resend.
# If no domain is verified but anujrankmantra190@gmail.com is, use this value:
#   "Jac Ghré <anujrankmantra190@gmail.com>"
RESEND_FROM_EMAIL="Jac Ghré <anujrankmantra190@gmail.com>"

# Inbox that receives all messages submitted via the site contact form.
# Also used as the delivery destination (to:) for contact emails.
CONTACT_INBOX=anujrankmantra190@gmail.com

NODE_ENV=development
